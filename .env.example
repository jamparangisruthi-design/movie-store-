# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/watchtogether?schema=public"

# Redis (Optional in dev, required for distributed scaling)
REDIS_URL="redis://localhost:6379"

# Security & Auth
SESSION_SECRET="your-super-secret-jwt-key-watchtogether-2026"
CORS_ORIGIN="http://localhost:3000"

# Legitimate Metadata APIs
TMDB_API_KEY=""

# WebRTC LiveKit SFU (Optional / Production Media Server)
LIVEKIT_URL="wss://watchtogether.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
